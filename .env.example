# "Ask the terminal" — copy to .env.local (never commit that file) and set the
# same variables in Vercel → Project → Settings → Environment Variables.
# Names only here; never put a real key in this file.

# Which provider answers questions: openai | anthropic | google
ASK_PROVIDER=
# The provider's model id (for anthropic it defaults to claude-haiku-4-5)
ASK_MODEL=

# Set the key for the provider you chose (standard variable names)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: shared rate limits across serverless instances (Upstash Redis).
# Without these, an in-memory limiter is used (best-effort on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: global daily cap on answered questions (default 300)
ASK_DAILY_LIMIT=
# Recommended: a long random string used to hash visitor IPs for rate limiting
ASK_HASH_SALT=
